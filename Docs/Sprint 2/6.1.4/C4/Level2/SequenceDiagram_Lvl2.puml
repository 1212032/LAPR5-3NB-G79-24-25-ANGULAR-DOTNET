@startuml
title "Request new operation"
participant "<<System>>\nSPA" as spa
participant "<<System>>\nBackEnd" as BackEnd


->spa: onInit()
    activate spa
    spa->BackEnd: HTTP Request: GET /doctors
    activate BackEnd
    BackEnd->BackEnd: getAll()
    BackEnd-->spa: doctorsDto array
    deactivate BackEnd

    spa->BackEnd: Request: GET /operationtypes
    activate BackEnd
    BackEnd->BackEnd: getAll()
    BackEnd-->spa: operationtypesDto array
    deactivate BackEnd
    
    spa->BackEnd: HTTP Request: GET /patients
    activate BackEnd
    BackEnd->BackEnd: getAll()
    BackEnd-->spa: patientsDto array
    deactivate BackEnd
<--spa: Display forms
deactivate spa

->spa: Request an operation
activate spa
spa-> BackEnd : HTTP Request: POST /operationrequests
activate BackEnd
BackEnd -> BackEnd : Add(DTO)

alt Doctor not Allowed
         spa<--BackEnd : status 405
         <-spa: status 405 
else Patient/Doctor not found
         spa<-- BackEnd : status 404
         <-spa: status 404 
else Operation Request successfully
         spa<--BackEnd : status 200
         <-spa: status 200 
deactivate spa
deactivate BackEnd
end


@enduml
