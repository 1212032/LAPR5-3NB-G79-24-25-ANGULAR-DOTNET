@startuml
title "Create New Patient Profile - Level 1"

actor Admin
participant "<<System>>" as Sys

Admin -> Sys : Input patient details (first name, last name, DOB, contact info)
activate Sys

alt Valid Input
    Sys -> Sys : Generate unique patient ID (Medical Record Number)
    Sys -> Sys : Validate email and phone number uniqueness
    Sys -> Sys : Store patient profile securely
    Admin <-- Sys : Response status 201 (Created)

else Invalid Input
    alt Email already exists
        Admin <-- Sys : Response status 400 (Email already exists)
    else Phone number already exists
        Admin <-- Sys : Response status 400 (Phone number already exists)
    else Other validation errors
        Admin <-- Sys : Response status 400 (Invalid input)
    end
end

deactivate Sys
@enduml
