@startuml
title "Create New Patient Profile - Level 2"

actor Admin
participant "<<System>>\nSPA" as SPA
participant "BackEnd" as BackEnd

Admin -> SPA : Input patient details (first name, last name, DOB, contact info, medical history)
activate SPA

SPA -> BackEnd : HTTP POST /patients (patient details)
activate BackEnd

BackEnd -> BackEnd : Validate input data

alt Valid Input
    BackEnd -> BackEnd : Generate unique patient ID (Medical Record Number)
    BackEnd -> BackEnd : Check for existing email and phone number

    alt Email and phone are unique
        BackEnd -> BackEnd : Store patient profile in memory
        SPA <-- BackEnd : Response status 201 (Created)
        Admin <-- SPA : Patient profile created successfully

    else Email already exists
        SPA <-- BackEnd : Response status 400 (Email already exists)
        Admin <-- SPA : Error: Email already exists

    else Phone number already exists
        SPA <-- BackEnd : Response status 400 (Phone number already exists)
        Admin <-- SPA : Error: Phone number already exists
    end
else Invalid Input
    SPA <-- BackEnd : Response status 400 (Invalid input)
    Admin <-- SPA : Error: Invalid input
end

deactivate BackEnd
deactivate SPA
@enduml
