@startuml
title "Request to update medical condition"
actor Admin
participant "<<View>>\nSearchMedicalCondition" as SearchView
participant "<<Controller>>\nSearchMedicalConditionComponent" as SearchController
participant "<<View>>\nUpdateMedicalCondition" as UpdateView
participant "<<Controller>>\nUpdateMedicalConditionComponent" as UpdateController
participant "<<Service>>\nMedicalConditionService" as AService
participant "BackEnd" as BackEnd

Admin -> SearchView: Request to search medical conditions
activate SearchView
SearchView -> SearchController: onInit()
activate SearchController

SearchController -> AService: getMedicalConditions()
activate AService
AService -> BackEnd: HTTP Request: GET /MedicalConditions\nGet all medical conditions
activate BackEnd
BackEnd --> AService: Return list of medical condition DTO
deactivate BackEnd
AService --> SearchController: Return list of medical condition DTO
deactivate AService

SearchController --> SearchView: Build list of medical conditions
deactivate SearchController
SearchView --> Admin: Display list of medical conditions
deactivate SearchView


opt
Admin -> SearchView: Change filters
activate SearchView
SearchView -> SearchController: getMedicalConditions(code,name)
activate SearchController
SearchController -> AService: getMedicalConditions(code,name)
activate AService
AService -> BackEnd: HTTP Request: GET /MedicalConditions\nGet all medical conditions
activate BackEnd
BackEnd --> AService: Return list of medical condition DTO
deactivate BackEnd
AService --> SearchController: Return list of medical condition DTO
deactivate AService
SearchController --> SearchView: Build list of medical conditions
deactivate SearchController
SearchView --> Admin: Display list of medical conditions
deactivate SearchView
end


Admin -> UpdateView: Select medical condition to update
activate UpdateView
UpdateView -> UpdateController: onInit(medicalConditionId)
activate UpdateController

UpdateController -> AService: getMedicalCondition(medicalConditionId)
activate AService
AService -> BackEnd: HTTP Request: GET /MedicalConditions/id\nGet medical condition
activate BackEnd
BackEnd --> AService: Return medical condition dto
deactivate BackEnd
AService --> UpdateController: Return medical condition dto
deactivate AService

UpdateController --> UpdateView: Build medical condition form
deactivate UpdateController
UpdateView --> Admin: Display medical condition form
deactivate UpdateView


Admin -> UpdateView : Change medical condition information and submit
activate UpdateView
UpdateView -> UpdateController: updateMedicalCondition()
activate UpdateController
UpdateController -> UpdateController: createDto()
UpdateController -> AService: updateMedicalCondition(medicalConditionDto)
activate AService
AService -> BackEnd: HTTP Request: PUT /MedicalConditions/id\nUpdate medical condition
activate BackEnd
BackEnd --> AService: Return medical condition dto
deactivate BackEnd
AService --> UpdateController: Return medical condition dto
deactivate AService
UpdateController --> UpdateView: Return success
deactivate UpdateController
UpdateView --> Admin: Display success
deactivate UpdateView

@enduml
