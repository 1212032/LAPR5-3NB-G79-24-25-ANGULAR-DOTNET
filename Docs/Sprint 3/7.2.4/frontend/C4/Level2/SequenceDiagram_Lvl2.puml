@startuml
title "Create Medical Condition"
actor Admin

participant "FrontEnd" as spa
participant "BackEnd2" as BackEnd


Admin->spa: Create Medical Condition
activate spa
spa-> BackEnd : HTTP Request: POST /medicalConditions
activate BackEnd

alt User not Allowed
    spa<--BackEnd : status 401
    Admin<-spa: status 401
else Medical Condition created successfully
    spa<--BackEnd : status 200
    Admin <-spa: status 200
    deactivate spa
    deactivate BackEnd
end


@enduml
