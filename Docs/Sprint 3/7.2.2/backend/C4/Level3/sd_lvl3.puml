@startuml
title "Create Allergy"
participant "CreateAllergyController" as controller
participant "AllergyService" as service
participant "Allergy" as a

participant "AllergyRepo" as repo
participant "AllergyMap" as mapper
participant "Dto" as dto
database "Database" as db


->controller: HTTP Request: Post /allergies()
activate controller
alt User not Allowed
    <--controller: status 401
end
controller-> service : createAllergy(dto)
activate service
service-> a : create
service-> repo: save(dto)
activate repo

repo-> db: save(dto)
repo-> mapper: toDTO()
activate mapper
mapper-> dto : create
mapper-->repo: dto
deactivate mapper



alt Operation Request successfully

    repo-->service : dto
    deactivate repo

    service-->controller: dto
    deactivate service

    <--controller: status 200
    deactivate controller

end
@enduml
